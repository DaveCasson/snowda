! mizuRoute control file generated by SUMMA public workflow scripts 
!
! --- DEFINE DIRECTORIES 
<ancil_dir>             /anvil/scratch/x-fhan/nwm-cali-proj/symfluence/SYMFLUENCE_data/domain_Ross_new_test/settings/mizuRoute/    ! Folder that contains ancillary data (river network, remapping netCDF) 
<input_dir>             /anvil/scratch/x-fhan/nwm-cali-proj/symfluence/SYMFLUENCE_data/domain_Ross_new_test/simulations/run_1/SUMMA/    ! Folder that contains runoff data from SUMMA 
<output_dir>            /anvil/scratch/x-fhan/nwm-cali-proj/symfluence/SYMFLUENCE_data/domain_Ross_new_test/simulations/run_1/mizuRoute/    ! Folder that will contain mizuRoute simulations 
<restart_dir>           /Users/dcasson/Data/snowda/summa/ross_lumped/states/ !
!
! --- NAMELIST FILENAME 
<param_nml>             param.nml.default    ! Spatially constant parameter namelist (should be stored in the ancil_dir) 
<pio_netcdf_type>       netcdf         !
<pio_netcdf_format>     64bit_offset   !
!
! --- DEFINE SIMULATION CONTROLS 
<case_name>             run_1    ! Simulation case name 
<sim_start>             2011-01-01 01:00:00    ! Time of simulation start 
<sim_end>               2018-12-31 23:00:00    ! Time of simulation end 
<route_opt>             1    ! Routing scheme. 0 -> accumRunoff, 1 -> IRF-UH, 2 -> IRF-KW, 3 -> KW-IRF, 4 -> MC-IRF 
<newFileFrequency>      single    ! Output file frequency (single, yearly, monthly, daily) 
<restart_write>         end   ! 
<continue_run>          F !
<fname_state_in>        ross_cold_state.nc !
!
! --- DEFINE TOPOLOGY FILE 
<fname_ntopOld>         topology.nc    ! Name of input netCDF for River Network 
<dname_sseg>            seg    ! Dimension name for reach in river network netCDF 
<dname_nhru>            hru    ! Dimension name for RN_HRU in river network netCDF 
<seg_outlet>            -9999    ! Outlet reach ID at which to stop routing (i.e. use subset of full network). -9999 to use full network 
<varname_area>          area    ! Name of variable holding hru area 
<varname_length>        length    ! Name of variable holding segment length 
<varname_slope>         slope    ! Name of variable holding segment slope 
<varname_HRUid>         hruId    ! Name of variable holding HRU id 
<varname_hruSegId>      hruToSegId    ! Name of variable holding the stream segment below each HRU 
<varname_segId>         segId    ! Name of variable holding the ID of each stream segment 
<varname_downSegId>     downSegId    ! Name of variable holding the ID of the next downstream segment 
!
! --- DEFINE RUNOFF FILE 
<fname_qsim>            run_1_timestep.nc    ! netCDF name for SUMMA runoff 
<vname_qsim>            averageRoutedRunoff    ! Variable name for SUMMA runoff 
<units_qsim>            m/s    ! Units of input runoff 
<dt_qsim>               3600    ! Time interval of input runoff in seconds 
<dname_time>            time    ! Dimension name for time 
<vname_time>            time    ! Variable name for time 
<dname_hruid>           hru      ! Dimension name for HM_HRU ID
<vname_hruid>           hruId    ! Variable name for HM_HRU ID
<ro_calendar>           gregorian   ! Calendar of the nc file
<input_fillvalue>       -9999    ! fill value for input variables
!<calendar>              standard    ! Calendar of the nc file 
!
! --- DEFINE RUNOFF MAPPING FILE 
<is_remap>              F    ! Logical to indicate runoff needs to be remapped to RN_HRU. T or F 
!
! --- MISCELLANEOUS 
<doesBasinRoute>        0    ! Hillslope routing options. 0 -> no (already routed by SUMMA), 1 -> use IRF 
